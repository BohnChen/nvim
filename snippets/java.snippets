snippet main
	public static void main(String[] args) {
		${1}
	}

snippet sout
	System.out.println(${1});

snippet if
	if (${1:condition}) {
		${2}
	}

snippet else
	} else {
		${1}
	}

snippet elif
	} else if (${1:condition}) {
		${2}

snippet for
	for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {
		${3}
	}

snippet foreach
	for (${1:Type} ${2:var} : ${3:list}) {
		${4}
	}

snippet while
	while (${1:condition}) {
		${2}
	}

snippet try
	try {
		${1}
	} catch (${2:Exception} e) {
		${3}
	}

snippet class
	public class ${1:ClassName} {
		${2}
	}

snippet method
	public ${1:void} ${2:name}(${3}) {
		${4}
	}

snippet psvm
	public static void main(String[] args) {
		${1}
	}

snippet new
	new ${1:ClassName}(${2})

snippet this
	this.${1:field} = ${1:field}

snippet get
	public ${1:Type} get${2:Name}() {
		return ${3:name};
	}

snippet set
	public void set${1:Name}(${1:Type} ${1:name}) {
		this.${1:name} = ${1:name};
	}

snippet override
	@Override
	public ${1:void} ${2:method}(${3}) {
		${4}
	}

snippet abstract
	abstract class ${1:ClassName} {
		${2}
	}

snippet impl
	implements ${1:Interface}

snippet ext
	extends ${1:SuperClass}
