snippet main
	int main(int argc, char *argv[]) {
		${1:niceday}
		return 0;
	}

snippet cout
	std::cout << ${1} << std::endl;

snippet cerr
	std::cerr << ${1} << std::endl;

snippet cin
	std::cin >> ${1};

snippet if
	if (${1:condition}) {
		${2}
	}

snippet else
	} else {
		${1}
	}

snippet elif
	} else if (${1:condition}) {
		${2}

snippet fori
	for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {
		${3}
	}

snippet forr
	for (auto &${1:item} : ${2:container}) {
		${3}
	}

snippet while
	while (${1:condition}) {
		${2}
	}

snippet class
	class ${1:Name} {
	 public:
		${1:Name}() = default;
	 	~${1:Name}() = default;

	 private:
		${2}
	};

snippet struct
	struct ${1:Name} {
		${2}
	};

snippet in
	#include <${1:iostream}>

snippet min
	#include "${1:header}.h"

snippet ns
	namespace ${1:name} {
		${2}
	} // namespace ${1:name}

snippet using
	using namespace ${1:std};

snippet log
	std::cout << "${1:debug}: " << ${2} << std::endl;

snippet auto
	auto ${1:name} = ${2};

snippet func
	${1:void} ${2:name}(${3}) {
		${4}
	}

snippet Test
	TEST(${1:Suite}, ${2:TestName}) {
		${3}
	}

snippet once
	#pragma once

snippet bohn
	int ${1:bohn};

snippet testvim
	int ${1:nice};
